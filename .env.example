# Copy to .env and edit. Every value has a working default for a single
# RTX PRO 6000 96 GB on x86_64 Linux.

# Checkpoint profile from the upstream recipe: exl3 | exl3-ple8 | nvfp4
# exl3-ple8 = EXL3 K4.25 experts + FP8 PLE table (~48 GiB). Best fit for 128 GB RAM hosts.
QUANT=exl3-ple8

# Port the OpenAI-compatible API listens on (host network).
PORT=8001

# CUDA device index of the RTX PRO 6000.
GPU=0

# Hugging Face cache on the host. Needs ~125 GB free for exl3-ple8.
HF_CACHE=$HOME/.cache/huggingface

# vLLM knobs (passed through to the upstream start.sh).
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=16
GPU_MEMORY_UTILIZATION=0.94
# MTP speculative draft length. 3 is the measured sweet spot on SM120; 0 disables MTP.
MTP_TOKENS=3

# KV cache RAM tier: an LMCache MP server in its own container (qwen38-lmcache).
# Long sessions evicted from the ~0.8M-token GPU KV pool come back from host RAM instead
# of being re-prefilled (130K tokens: 19.5 s -> 0.64 s). See docs/kv-ram-offload.md.
# The tier is inclusive (it also holds what is on the GPU), so it must be clearly larger
# than the GPU pool: 64 GiB ~= 1.25M tokens. 32 GiB measured ~0 hits. Keep it <= ~70 on a
# 128 GB host: the PLE table needs ~35-48 GB of page cache.
KV_RAM_GB=64
KV_RAM_WATERMARK=0.95
# vLLM's unified attention block size N ("Setting attention block size to N tokens" in
# the logs). 3200 with MTP 3. Re-read it after changing MTP_TOKENS or the KV dtype.
KV_BLOCK_TOKENS=3200
# Batch budget. Empty = 2N-1, the LMCache recommendation for GDN hybrids (must be >= N).
MAX_BATCHED_TOKENS=
# LMCache wheel installed on top of the recipe image -> local image qwen38-rtx:lmc056.
LMCACHE_VERSION=0.5.6
# LMCache ports (localhost). Defaults 5555/8080/9090 collide with common dashboards.
LMCACHE_PORT=6555
LMCACHE_HTTP_PORT=6580
LMCACHE_METRICS_PORT=6590

# Docker restart policy applied to both containers.
# unless-stopped = comes back after reboot, stays down after a manual `docker stop`.
RESTART_POLICY=unless-stopped

# Where the upstream recipe gets cloned, and the commit this repo was verified against.
RECIPE_DIR=./vendor/sm12x-exl3-qwen3.8-flash-next
RECIPE_REPO=https://github.com/tpurtell/sm12x-exl3-qwen3.8-flash-next.git
RECIPE_COMMIT=847f45b1730069eab4bdb5e29361f9ea94ac5e05
